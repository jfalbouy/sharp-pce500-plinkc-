0BE000                   			org	$be000
0BE000                   	;	2026-10-07 : l'objet est charge en 0BE000h (CALL &BE000), plus en 0BF000h.
0BE000                   	;	Avec la vitesse propre et INIT "L:T", il ne tenait plus dans les 3072
0BE000                   	;	octets de 0BF000h au plafond 0BFC00h de la zone langage machine ; un
0BE000                   	;	LOADM au-dela ecrase la zone systeme (s1_top, d_link...). Reserver donc
0BE000                   	;	7168 octets (01C00h) avant LOADM :
0BE000                   	;	    POKE &BFE03,&1A,&FD,&B,0,&1C,0 : CALL &FFFD8
0BE000                   	;	verifier.py controle que l'objet entier, table comprise, reste sous
0BE000                   	;	0BFC00h (la table est ajoutee apres END : aucun assert ne la voit).
0BE000                   	;----------------------------------------------------------------------
0BE000                   	;
0BE000                   	;	Pocket Link Cache Device Driver ver 1.62
0BE000                   	;	Installation program
0BE000                   	;	for PC-E500 series pocket computer
0BE000                   	;	Copyright (c) 1996,1997,1999 by Daisuke Mizobata
0BE000                   	;
0BE000                   	;	based on PLINK.SYS ver 1.04
0BE000                   	;	Copyright (c) 1990,93,94 N.Kon
0BE000                   	;
0BE000                   	;----------------------------------------------------------------------
0BE000                   	;----------------------------------------------------------------------
0BE000                   	;
0BE000                   	;	Mise a jour 2026 (J.-F. Albouy) - derive de PLINKC 1.62, voir NOTICE
0BE000                   	;	  - constantes systeme tirees de pce500.inc ;
0BE000                   	;	  - desinstallation par CALL &BE000 "-U" (deliage + SET/KILL), qui
0BE000                   	;	    reconnait aussi un bloc de la 1.62 d'origine ;
0BE000                   	;	  - INIT "L:?" : etat du pilote (mode, numero de device, bloc) ;
0BE000                   	;	  - vitesse PROPRE au pilote (19200 par defaut), plus celle du COM: du
0BE000                   	;	    BASIC qu'un RESET remet a 1200 : INIT "L:Bnnnnn" la change, INIT
0BE000                   	;	    "L:T" teste la liaison (commande 'Q') ;
0BE000                   	;	  - INIT "L:H" : version, taille, etat et commandes ; une option
0BE000                   	;	    inconnue est signalee (la 1.62 videait le tampon sans rien dire) ;
0BE000                   	;	  - INIT "L:2" : mode 256K ;
0BE000                   	;	  - apres chaque INIT "L:1"/"L:2"/"L:5", commande 'Q' : le serveur
0BE000                   	;	    (APLINKS 1.07) rend son mode reel, que le pilote adopte ;
0BE000                   	;	  - � deja installe � detaille : etat du pilote en place, autre
0BE000                   	;	    version, bloc non chaine, ou "L:" pris par un autre pilote.
0BE000                   	;	Protocole : seul ajout, la commande 'Q' (APLINKS 1.07 y repond, les
0BE000                   	;	serveurs anciens l'ignorent) ; 'S' est inchange. Le corps ne differe de la 1.62 que par INIT "L:?",
0BE000                   	;	INIT "L:2" et mpb256. verifier.py controle la table de relocation.
0BE000                   	;	Assembleur : xasm2026-4 (dialecte A62 : rel, #defmacro, suborg, { }).
0BE000                   	;	Reference d'origine : reference/plinkc.a62.asm -> PLINKC.OBJ.
0BE000                   	;
0BE000                   	;----------------------------------------------------------------------
0BE000                   	;
0BE000                   	
0BE000                   	;----------------------------------------------------------------------
0BE000                   	;		Definitions numeriques
0BE000                   	;----------------------------------------------------------------------
0BE000                   	;	Constantes systeme : pce500.inc (genere depuis les tables du
0BE000                   	;	desassembleur SC62015Disassembler, noms identiques a ses sorties).
0BE000                   	;	Correspondance avec les noms d'origine de PLINKC 1.62 :
0BE000                   	;	  fcs -> fcs_call         iocs -> iocs_call      iroot -> d_link
0BE000                   	;	  sio_rcv_vct -> intv_sio_rx   sio_param -> sio_baud
0BE000                   	;	  base -> bp_ram   bx/cx/dx -> bl/cl/dl   cx+1 -> ch
0BE000                   	;	  key_strobe_2 -> koh      sio_ctrl_reg -> ucr    sio_stat_reg -> usr
0BE000                   	;	  sio_rx_reg -> rxd        sio_tx_reg -> txd      intr_mask_reg -> imr
0BE000                   	;	  system_stat_reg -> ssr   btext -> txtbas        bdata -> datbas
0BE000                   	;	  iwork -> iocsw           s1top -> s1_top        s1end -> s1_btm
0BE000                   	;	  bworkp -> baswrk         $bfcbe -> softint
0BE000                   	;	Retirees car inutilisees : iocs_fook, bpmax, keyvec, cdrv, rev.
0BE000                   			include	pce500.inc
0BE000                   	txtbas: equ 0CBH ; TEXT.BAS courant
0BE000                   	datbas: equ 0CEH ; DATA.BAS courant
0BE000                   	bl:     equ 0D4H ; registre BL / BX bas
0BE000                   	cl:     equ 0D6H ; registre CL / CX bas
0BE000                   	ch:     equ 0D7H ; registre CH / CX haut
0BE000                   	dl:     equ 0D8H ; registre DL / DX bas
0BE000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
0BE000                   	bp_ram: equ 0ECH ; base pointer RAM interne
0BE000                   	koh:    equ 0F1H ; Key Output Buffer haut (KOH) : pilote les pins KO8-KO15. Lecture/ecriture (manuel CPU p9-10)
0BE000                   	ucr:    equ 0F7H ; UART Control Register : bit 7 BOE (break : force 0 sur TXD), bits 6-4 debit (0 arrete ET REINITIALISE l UART, 1 300, 2 600, 3 1200, 4 2400, 5 4800, 6 9600, 7 19200 bps), bits 3-2 parite (00 paire, 01 impaire, 1x aucune), bit 1 ...
0BE000                   	usr:    equ 0F8H ; UART Status Register : bit 5 RXR caractere recu, bit 4 TXE emetteur au repos, bit 3 TXR tampon d'emission libre, bit 2 FE erreur de trame, bit 1 OE surcharge, bit 0 PE erreur de parite. RXR et TXR alimentent les bits RXRI/TXRI ...
0BE000                   	rxd:    equ 0F9H ; UART Receive Buffer : le caractere recu ; le lire remet RXR a zero. LECTURE SEULE (manuel CPU p12-14)
0BE000                   	txd:    equ 0FAH ; UART Transmit Buffer : le caractere a emettre ; peut etre ecrit pendant l'emission du precedent, TXR dit si le tampon est libre. ECRITURE SEULE (manuel CPU p14-15)
0BE000                   	imr:    equ 0FBH ; Interrupt Mask Register : bit 7 IRM masque general, bit 6 EXM interruption EXTERNE (pin IRQ ; sur PC-E500 ce pin est cable au controleur de batterie, d'ou 'batterie faible' cote machine), bit 5 RXRM reception SIO, bit 4 TXRM em ...
0BE000                   	ssr:    equ 0FFH ; System Status Register : bit 3 ONK touche ON enfoncee, bit 2 RSF (1 : on sort d'un HALT/OFF, 0 : le pin RESET a ete active), bit 1 CI entree cassette, bit 0 TEST entree de test. LECTURE SEULE (manuel CPU p20-21)
0BE000                   	s1_top:           equ 0BFC15H ; top of S1 (nom et libelle de REGISTER.ASM) ; lead address du slot 0 = lecteur S1:, 080000h sur PC-E500S (3 octets ; manuel technique, Parameter of memory block device)
0BE000                   	d_link:           equ 0BFCA2H ; device link pointer / IOCSH
0BE000                   	softint:          equ 0BFCBEH ; bit 7 = break, bit 6 = batterie faible
0BE000                   	intv_sio_rx:      equ 0BFCD5H ; vecteur interruption reception SIO, ISR/IMR bit 5 RXRM ; reception d'un octet SIO terminee (manuel technique, List of interrupt factor p91-92)
0BE000                   	s1_btm:           equ 0BFCDEH ; bottom of S1 (nom et libelle de REGISTER.ASM) ; le manuel dit "last address of slot 0 (S1:) + 1" et La Feuille du Sharp en fait le pointeur de la 1re zone de travail, la pile utilisateur U : trois lectures d'une me ...
0BE000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
0BE000                   	fcs_call:         equ 0FFFE4H ; FCS call entry
0BE000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
0BE000                   	fcs_write_block:          equ 04H   ; ecriture d'un bloc ((cl) = handle, X = source, Y = nombre d'octets ; retour X = adresse su
0BE000                   	fcs_write_byte:           equ 06H   ; ecriture d'un octet ((cl) = handle, a = donnee ; retour b = nombre d'octets ecrits)
0BE000                   	iocs_find_drive:          equ 00H   ; recherche du device et du lecteur d'apres le nom de lecteur (X = adresse du nom ; retour (
0BE000                   	iocs_header_addr:         equ 01H   ; adresse du header d'apres le numero de device ((cl) = device ; retour X = adresse du heade
0BE000                   	iocs_fmt_drive:           equ 04H   ; iocs_format_drive - formatage du device designe par le nom de lecteur (X = nom de lecteur suivi de la chaine d
0BE000                   	dev_key:          equ 1H    ; device 1 (STDI:/KYBD:)
0BE000                   	dev_memcard:      equ 6H    ; device 6 (S1:/S2:/S3:)
0BE000                   	d1_key_read:      equ 43H   ; key_key_read - lecture d'une touche, apres traitement des touches SHIFT et CTRL (a bit 7 = 0 ...
0BE000                   	d1_buffer_clear:  equ 45H   ; key_buffer_clear - vidage du tampon de balayage et du tampon clavier
0BE000                   	d6_search_phys:   equ 41H   ; memcard_search_phys - adresse physique d'un bloc d'apres son nom ((ch) = slot 0/1/2, X = nom du bloc ...
0BE000                   	d6_condense:      equ 47H   ; memcard_condense - compactage de l'espace libre des blocs memoire ((ch) = slot)
0BE000                   	
0BE000                   	sectsiz:	equ	128
0BE000                   	cache_sect:	equ	sectsiz+1
0BE000                   	cache_next:	equ	cache_sect+2
0BE000                   	cache_size:	equ	cache_next+3
0BE000                   	n_fcache:	equ	7		;	Nombre de secteurs dans le cache FAT
0BE000                   	n_dcache:	equ	1		;	Nombre de secteurs dans le cache de donnees
0BE000                   	dtop:		equ	44
0BE000                   	timeout:	equ	40000		; Delai d'attente (environ 1 seconde)
0BE000                   	def_ucr:	equ	$78			; Vitesse du pilote par defaut (2026) : 19200 bauds,
0BE000                   						; sans parite, 8 bits, 1 stop (format de ucr / sio_baud)
