0BE49E                   	;		En-tete du fichier d'en-tete de l'appareil
0BE49E                   	;----------------------------------------------------------------------
0BE49E FB 50 4C 49 4E 4B 	btop:	db	$fb,'PLINK   SYS'		;Nom du bloc de peripherique
0BE4A4 20 20 20 53 59 53 	
0BE4AA 25                			db	$25						;Attributs de bloc de memoire
0BE4AB 00 00 00 00       			dw	0,0						;Date et heure
0BE4AF FE 0C 00          			dp	blen					;Nombre d'octets dans le bloc memoire
0BE4B2 00 00             			dw	0
0BE4B4 FE 0C 00          			dp	blen					;Nombre d'octets de l'entite de fichier
0BE4B7 FE 0C 00          			dp	blen					;Nombre d'octets dans le bloc memoire
0BE4BA 00 00 00 00 00 00 			dp	0,0
0BE4C0                   	;----------------------------------------------------------------------
0BE4C0                   	;		En-tete du pilote de peripherique
0BE4C0                   	;----------------------------------------------------------------------
0BE4C0 00 00 00          	ihead:		dp	0			;Adresse du prochain en-tete de pilote de peripherique
0BE4C3 00                	devno:		db	0			;Numero d'appareil (variable)
0BE4C4 83                			db	$83				;Attribut de peripherique (identique a E :)
0BE4C5 0A E5 0B          			rel dp	devmain		;Adresse du corps du pilote de peripherique
