0BE4CB                   	;Version de 128 Ko
0BE4CB F0                	mpb128:		db	$f0			;Descripteur de media (peut etre approprie)
0BE4CC 80 00             			dw	sectsiz			;Nombre d'octets par secteur
0BE4CE 03                			db	4-1				;(Nombre d'octets par secteur / 32) -1
0BE4CF 02                			db	2				;log 2 (nombre d'octets par secteur / 32)
0BE4D0 00                			db	0				;???
0BE4D1 01                			db	1				;???
0BE4D2 00 00             			dw	0				;Premier numero de secteur de zone FAT
0BE4D4 08                			db	8				;???
0BE4D5 80 00             			dw	128				;Nombre maximum de fichiers stockables
0BE4D7 2C 00             			dw	dtop			;Numero du secteur de depart de la zone de donnees
0BE4D9 D5 03             			dw	980+1			;Nombre total de secteurs dans la zone de donnees + 1
0BE4DB 0C                			db	12				;Nombre total de secteurs dans la zone FAT
0BE4DC 0C 00             			dw	12				;Premier numero de secteur de la zone DIR
0BE4DE                   	;Donnees referencees dans DS
