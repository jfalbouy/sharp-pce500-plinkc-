0BE1E9                   	;----------------------------------------------------------------------
0BE1E9                   	;		Desinstallation : CALL &BE000 "-U"
0BE1E9                   	;----------------------------------------------------------------------
0BE1E9                   	;	Le pilote ne tient AUCUN vecteur au repos : il ne detourne la SIO que
0BE1E9                   	;	le temps d'un appel (devmain la rend en jump00). Desinstaller, c'est
0BE1E9                   	;	donc delier son en-tete de la chaine des devices, puis faire taper
0BE1E9                   	;	SET et KILL a l'utilisateur : ce sont des commandes de MODE DIRECT,
0BE1E9                   	;	qu'un programme ne peut pas executer.
0BE1E9                   	;	Le bloc se retrouve par la CHAINE DES BLOCS de S1:, pas par d_link :
0BE1E9                   	;	si un amorcage a perdu le maillon, le bloc est toujours la.
0BE1E9                   	uninst:
0BE1E9 8C 15 FC 0B       		mv	x,[s1_top]
0BE1ED 95 84 12          		mv	y,[x+$12]
0BE1F0 45 45             	un_blk:	add	x,y
0BE1F2 90 04             		mv	a,[x]
0BE1F4 60 FB             		cmp	a,$fb
0BE1F6 1A 90             		jrnz	un_absent		;	Fin de la chaine des blocs
0BE1F8 A4 00             		mv	(dest),x
0BE1FA 0D 9E E4 0B       		mv	y,btop			;	Signature + nom, lus dans l'image (jamais relogee)
0BE1FE 09 0C             		mv	il,12
0BE200 04 9C E2          		call	compare
0BE203 84 00             		mv	x,(dest)
0BE205 95 84 11          		mv	y,[x+$11]		;	Taille du bloc (MV ne touche pas aux drapeaux)
0BE208 1B 1A             		jrnz	un_blk
0BE20A                   	
0BE20A                   	;	Le deliage ne touche qu'a l'en-tete IOCS : on reconnait donc le bloc a
0BE20A                   	;	cet en-tete, pas a sa taille (qui change a chaque version) - le nom de
0BE20A                   	;	device 'L:',0 a sa place (bloc+2Ah), donc le lien suivant en bloc+22h.
0BE20A                   	;	C'est la disposition de la 1.62 d'origine et de toutes les versions
0BE20A                   	;	2026 ; aucune ne tient de vecteur au repos.
0BE20A 08 2A             		mv	a,dvname-btop
0BE20C 45 40             		add	x,a
0BE20E 0D C8 E4 0B       		mv	y,dvname		;	'L:',0 de l'image
0BE212 09 03             		mv	il,3
0BE214 04 9C E2          		call	compare
0BE217 1A 79             		jrnz	un_autre
0BE219                   	
0BE219                   	;	Aucun pilote AU-DESSUS du notre. Le KILL de PLINK.SYS ferait descendre
0BE219                   	;	tous les blocs suivants SANS relocation : sans dommage pour TEXT.BAS et
0BE219                   	;	DATA.BAS (la ROM les recale), fatal pour un autre pilote (mesure du
0BE219                   	;	2026-09-25 avec BASEXT.SYS au-dessus : la machine tombe). Meme regle de
0BE219                   	;	reconnaissance que l'installateur : signature $fb et bits $0c de
0BE219                   	;	l'attribut.
0BE219 84 00             		mv	x,(dest)
0BE21B 95 84 11          	un_sup:	mv	y,[x+$11]
0BE21E 45 45             		add	x,y
0BE220 90 04             		mv	a,[x]
0BE222 60 FB             		cmp	a,$fb
0BE224 1A 29             		jrnz	un_delier		;	Fin de chaine : rien au-dessus
0BE226 90 84 0C          		mv	a,[x+$0c]
0BE229 64 0C             		test	a,$0c
0BE22B 19 12             		jrz	un_sup
0BE22D A4 03             		mv	(bottom),x
0BE22F 0C 20 E4 0B       		mv	x,sup_m
0BE233 0D 21 00 00       		mv	y,sup_e-sup_m
0BE237 04 B4 E1          		call	puts
0BE23A 84 03             		mv	x,(bottom)
0BE23C 6C 04             		inc	x			;	Nom 8.3 du pilote fautif (11 octets)
0BE23E 0D 0B 00 00       		mv	y,11
0BE242 04 B4 E1          		call	puts
0BE245 0C 41 E4 0B       		mv	x,sup2_m
0BE249 0D 17 00 00       		mv	y,sup2_e-sup2_m
0BE24D 12 33             		jr	un_fin
0BE24F                   	
0BE24F                   	;	Delier notre en-tete IOCS (bloc + ihead-btop), s'il est encore chaine
0BE24F                   	un_delier:
0BE24F 84 00             		mv	x,(dest)
0BE251 08 22             		mv	a,ihead-btop
0BE253 45 40             		add	x,a
0BE255 A4 03             		mv	(bottom),x		;	Notre en-tete
0BE257 0D A2 FC 0B       		mv	y,d_link
0BE25B 94 05             	un_lnk:	mv	x,[y]
0BE25D 6C 04             		inc	x
0BE25F 18 19             		jrz	un_ok			;	$fffff : fin de chaine, plus chaine
0BE261 7C 04             		dec	x
0BE263 18 15             		jrz	un_ok			;	0 : chaine vide
0BE265 A5 09             		mv	(offset),y		;	Emplacement du lien qui designe x
0BE267 A4 06             		mv	(mdf),x
0BE269 85 03             		mv	y,(bottom)
0BE26B D7 05 06          		cmpp	(mdf),y
0BE26E 18 04             		jrz	un_trouve
0BE270 FD 54             		mv	y,x			;	Le lien suivant est le 1er champ de l'en-tete
0BE272 13 19             		jr	un_lnk
0BE274                   	un_trouve:
0BE274 94 04             		mv	x,[x]			;	Notre successeur...
0BE276 85 09             		mv	y,(offset)
0BE278 B4 05             		mv	[y],x			;	...prend notre place
0BE27A 0C 0E E3 0B       	un_ok:	mv	x,uok_m
0BE27E 0D 4D 00 00       		mv	y,uok_e-uok_m
0BE282 04 B4 E1          	un_fin:	call	puts
0BE285 02 A4 E1          		jp	fin
0BE288                   	
0BE288                   	un_absent:
0BE288 0C E4 E3 0B       		mv	x,abs_m
0BE28C 0D 17 00 00       		mv	y,abs_e-abs_m
0BE290 13 10             		jr	un_fin
0BE292                   	un_autre:
0BE292 0C FB E3 0B       		mv	x,oth_m
0BE296 0D 25 00 00       		mv	y,oth_e-oth_m
0BE29A 13 1A             		jr	un_fin
0BE29C                   	
0BE29C                   	;	compare : IL octets de [x] et de [y] ; Z si identiques
0BE29C E0 24 06          	compare:	mv	(mdf),[x++]
0BE29F 90 25             		mv	a,[y++]
0BE2A1 63 06             		cmp	(mdf),a
0BE2A3 1A 04             		jrnz	compare_e
