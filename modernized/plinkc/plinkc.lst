0BE520                   	;	2026 : le pilote prend SA vitesse (drv_ucr), plus celle du COM: du BASIC
0BE520                   	;	(sio_baud, 0BFD33h) que la 1.62 suivait. Un RESET remet sio_baud a 1200
0BE520                   	;	bauds (03Ch) et desaccordait le pilote du PC ; drv_ucr est dans le bloc,
0BE520                   	;	qui survit au RESET, et le COM: des programmes BASIC n'est pas touche.
0BE520 D0 08 46 E6 0B    			rel mv	(i_work3),[drv_ucr]	;Charger les parametres du pilote
0BE525 71 08 FD          			and	(i_work3),$fd	   		;Ce force a 8 bits
