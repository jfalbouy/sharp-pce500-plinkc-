0BF1E0                   	;----------------------------------------------------------------------
0BF1E0                   	;		Desinstallation : CALL &BF000 "-U"
0BF1E0                   	;----------------------------------------------------------------------
0BF1E0                   	;	Le pilote ne tient AUCUN vecteur au repos : il ne detourne la SIO que
0BF1E0                   	;	le temps d'un appel (devmain la rend en jump00). Desinstaller, c'est
0BF1E0                   	;	donc delier son en-tete de la chaine des devices, puis faire taper
0BF1E0                   	;	SET et KILL a l'utilisateur : ce sont des commandes de MODE DIRECT,
0BF1E0                   	;	qu'un programme ne peut pas executer.
0BF1E0                   	;	Le bloc se retrouve par la CHAINE DES BLOCS de S1:, pas par d_link :
0BF1E0                   	;	si un amorcage a perdu le maillon, le bloc est toujours la.
0BF1E0                   	uninst:
0BF1E0 8C 15 FC 0B       		mv	x,[s1_top]
0BF1E4 95 84 12          		mv	y,[x+$12]
0BF1E7 45 45             	un_blk:	add	x,y
0BF1E9 90 04             		mv	a,[x]
0BF1EB 60 FB             		cmp	a,$fb
0BF1ED 1A 90             		jrnz	un_absent		;	Fin de la chaine des blocs
0BF1EF A4 00             		mv	(dest),x
0BF1F1 0D 95 F4 0B       		mv	y,btop			;	Signature + nom, lus dans l'image (jamais relogee)
0BF1F5 09 0C             		mv	il,12
0BF1F7 04 93 F2          		call	compare
0BF1FA 84 00             		mv	x,(dest)
0BF1FC 95 84 11          		mv	y,[x+$11]		;	Taille du bloc (MV ne touche pas aux drapeaux)
0BF1FF 1B 1A             		jrnz	un_blk
0BF201                   	
0BF201                   	;	Le deliage ne touche qu'a l'en-tete IOCS : on reconnait donc le bloc a
0BF201                   	;	cet en-tete, pas a sa taille (qui change a chaque version) - le nom de
0BF201                   	;	device 'L:',0 a sa place (bloc+2Ah), donc le lien suivant en bloc+22h.
0BF201                   	;	C'est la disposition de la 1.62 d'origine et de toutes les versions
0BF201                   	;	2026 ; aucune ne tient de vecteur au repos.
0BF201 08 2A             		mv	a,dvname-btop
0BF203 45 40             		add	x,a
0BF205 0D BF F4 0B       		mv	y,dvname		;	'L:',0 de l'image
0BF209 09 03             		mv	il,3
0BF20B 04 93 F2          		call	compare
0BF20E 1A 79             		jrnz	un_autre
0BF210                   	
0BF210                   	;	Aucun pilote AU-DESSUS du notre. Le KILL de PLINK.SYS ferait descendre
0BF210                   	;	tous les blocs suivants SANS relocation : sans dommage pour TEXT.BAS et
0BF210                   	;	DATA.BAS (la ROM les recale), fatal pour un autre pilote (mesure du
0BF210                   	;	2026-09-25 avec BASEXT.SYS au-dessus : la machine tombe). Meme regle de
0BF210                   	;	reconnaissance que l'installateur : signature $fb et bits $0c de
0BF210                   	;	l'attribut.
0BF210 84 00             		mv	x,(dest)
0BF212 95 84 11          	un_sup:	mv	y,[x+$11]
0BF215 45 45             		add	x,y
0BF217 90 04             		mv	a,[x]
0BF219 60 FB             		cmp	a,$fb
0BF21B 1A 29             		jrnz	un_delier		;	Fin de chaine : rien au-dessus
0BF21D 90 84 0C          		mv	a,[x+$0c]
0BF220 64 0C             		test	a,$0c
0BF222 19 12             		jrz	un_sup
0BF224 A4 03             		mv	(bottom),x
0BF226 0C 17 F4 0B       		mv	x,sup_m
0BF22A 0D 21 00 00       		mv	y,sup_e-sup_m
0BF22E 04 AB F1          		call	puts
0BF231 84 03             		mv	x,(bottom)
0BF233 6C 04             		inc	x			;	Nom 8.3 du pilote fautif (11 octets)
0BF235 0D 0B 00 00       		mv	y,11
0BF239 04 AB F1          		call	puts
0BF23C 0C 38 F4 0B       		mv	x,sup2_m
0BF240 0D 17 00 00       		mv	y,sup2_e-sup2_m
0BF244 12 33             		jr	un_fin
0BF246                   	
0BF246                   	;	Delier notre en-tete IOCS (bloc + ihead-btop), s'il est encore chaine
0BF246                   	un_delier:
0BF246 84 00             		mv	x,(dest)
0BF248 08 22             		mv	a,ihead-btop
0BF24A 45 40             		add	x,a
0BF24C A4 03             		mv	(bottom),x		;	Notre en-tete
0BF24E 0D A2 FC 0B       		mv	y,d_link
0BF252 94 05             	un_lnk:	mv	x,[y]
0BF254 6C 04             		inc	x
0BF256 18 19             		jrz	un_ok			;	$fffff : fin de chaine, plus chaine
0BF258 7C 04             		dec	x
0BF25A 18 15             		jrz	un_ok			;	0 : chaine vide
0BF25C A5 09             		mv	(offset),y		;	Emplacement du lien qui designe x
0BF25E A4 06             		mv	(mdf),x
0BF260 85 03             		mv	y,(bottom)
0BF262 D7 05 06          		cmpp	(mdf),y
0BF265 18 04             		jrz	un_trouve
0BF267 FD 54             		mv	y,x			;	Le lien suivant est le 1er champ de l'en-tete
0BF269 13 19             		jr	un_lnk
0BF26B                   	un_trouve:
0BF26B 94 04             		mv	x,[x]			;	Notre successeur...
0BF26D 85 09             		mv	y,(offset)
0BF26F B4 05             		mv	[y],x			;	...prend notre place
0BF271 0C 05 F3 0B       	un_ok:	mv	x,uok_m
0BF275 0D 4D 00 00       		mv	y,uok_e-uok_m
0BF279 04 AB F1          	un_fin:	call	puts
0BF27C 02 9B F1          		jp	fin
0BF27F                   	
0BF27F                   	un_absent:
0BF27F 0C DB F3 0B       		mv	x,abs_m
0BF283 0D 17 00 00       		mv	y,abs_e-abs_m
0BF287 13 10             		jr	un_fin
0BF289                   	un_autre:
0BF289 0C F2 F3 0B       		mv	x,oth_m
0BF28D 0D 25 00 00       		mv	y,oth_e-oth_m
0BF291 13 1A             		jr	un_fin
0BF293                   	
