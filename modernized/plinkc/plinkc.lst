0BE4E5 00                			db	0
0BE4E6 01                			db	1
0BE4E7 00 00             			dw	0
0BE4E9 08                			db	8
0BE4EA 80 00             			dw	128
0BE4EC 50 00             			dw	80			;Numero du secteur de depart de la zone de donnees
0BE4EE B1 0F             			dw	4016+1		;Nombre total de secteurs dans la zone de donnees + 1
0BE4F0 30                			db	48			;Nombre total de secteurs dans la zone FAT
0BE4F1 30 00             			dw	48			;Premier numero de secteur de la zone DIR
0BE4F3                   	;
0BE4F3 30 00             			dw	48
0BE4F5                   	;Version de 256 Ko (ajout 2026). Meme regle que les deux autres : FAT,
0BE4F5                   	;puis 32 secteurs de repertoire (128 fichiers), puis les donnees, pour
0BE4F5                   	;256K/128 = 2048 secteurs : 24 + 32 + 1992. FAT de 12 bits : 24 secteurs
