0BF000                   	;
0BF000                   	;	Mise a jour 2026 (J.-F. Albouy) - derive de PLINKC 1.62, voir NOTICE
0BF000                   	;	  - constantes systeme tirees de pce500.inc ;
0BF000                   	;	  - desinstallation par CALL &BF000 "-U" (deliage + SET/KILL), qui
0BF000                   	;	    reconnait aussi un bloc de la 1.62 d'origine ;
0BF000                   	;	  - INIT "L:?" : etat du pilote (mode, numero de device, bloc) ;
0BF000                   	;	  - INIT "L:H" : version, taille, etat et commandes ; une option
0BF000                   	;	    inconnue est signalee (la 1.62 videait le tampon sans rien dire) ;
0BF000                   	;	  - INIT "L:2" : mode 256K ;
0BF000                   	;	  - apres chaque INIT "L:1"/"L:2"/"L:5", commande 'Q' : le serveur
0BF000                   	;	    (APLINKS 1.07) rend son mode reel, que le pilote adopte ;
0BF000                   	;	  - � deja installe � detaille : etat du pilote en place, autre
0BF000                   	;	    version, bloc non chaine, ou "L:" pris par un autre pilote.
0BF000                   	;	Protocole : seul ajout, la commande 'Q' (APLINKS 1.07 y repond, les
0BF000                   	;	serveurs anciens l'ignorent) ; 'S' est inchange. Le corps ne differe de la 1.62 que par INIT "L:?",
0BF000                   	;	INIT "L:2" et mpb256. verifier.py controle la table de relocation.
0BF000                   	;	Assembleur : xasm2026-4 (dialecte A62 : rel, #defmacro, suborg, { }).
0BF000                   	;	Reference d'origine : reference/plinkc.a62.asm -> PLINKC.OBJ.
0BF000                   	;
0BF000                   	;----------------------------------------------------------------------
0BF000                   	;
0BF000                   	
0BF000                   	;----------------------------------------------------------------------
0BF000                   	;		Definitions numeriques
0BF000                   	;----------------------------------------------------------------------
0BF000                   	;	Constantes systeme : pce500.inc (genere depuis les tables du
0BF000                   	;	desassembleur SC62015Disassembler, noms identiques a ses sorties).
0BF000                   	;	Correspondance avec les noms d'origine de PLINKC 1.62 :
0BF000                   	;	  fcs -> fcs_call         iocs -> iocs_call      iroot -> d_link
0BF000                   	;	  sio_rcv_vct -> intv_sio_rx   sio_param -> sio_baud
0BF000                   	;	  base -> bp_ram   bx/cx/dx -> bl/cl/dl   cx+1 -> ch
0BF000                   	;	  key_strobe_2 -> koh      sio_ctrl_reg -> ucr    sio_stat_reg -> usr
0BF000                   	;	  sio_rx_reg -> rxd        sio_tx_reg -> txd      intr_mask_reg -> imr
0BF000                   	;	  system_stat_reg -> ssr   btext -> txtbas        bdata -> datbas
0BF000                   	;	  iwork -> iocsw           s1top -> s1_top        s1end -> s1_btm
0BF000                   	;	  bworkp -> baswrk         $bfcbe -> softint
0BF000                   	;	Retirees car inutilisees : iocs_fook, bpmax, keyvec, cdrv, rev.
0BF000                   			include	pce500.inc
0BF000                   	txtbas: equ 0CBH ; TEXT.BAS courant
0BF000                   	datbas: equ 0CEH ; DATA.BAS courant
0BF000                   	bl:     equ 0D4H ; registre BL / BX bas
0BF000                   	cl:     equ 0D6H ; registre CL / CX bas
0BF000                   	ch:     equ 0D7H ; registre CH / CX haut
0BF000                   	dl:     equ 0D8H ; registre DL / DX bas
0BF000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
0BF000                   	bp_ram: equ 0ECH ; base pointer RAM interne
0BF000                   	koh:    equ 0F1H ; Key Output Buffer haut (KOH) : pilote les pins KO8-KO15. Lecture/ecriture (manuel CPU p9-10)
0BF000                   	ucr:    equ 0F7H ; UART Control Register : bit 7 BOE (break : force 0 sur TXD), bits 6-4 debit (0 arrete ET REINITIALISE l UART, 1 300, 2 600, 3 1200, 4 2400, 5 4800, 6 9600, 7 19200 bps), bits 3-2 parite (00 paire, 01 impaire, 1x aucune), bit 1 ...
0BF000                   	usr:    equ 0F8H ; UART Status Register : bit 5 RXR caractere recu, bit 4 TXE emetteur au repos, bit 3 TXR tampon d'emission libre, bit 2 FE erreur de trame, bit 1 OE surcharge, bit 0 PE erreur de parite. RXR et TXR alimentent les bits RXRI/TXRI ...
0BF000                   	rxd:    equ 0F9H ; UART Receive Buffer : le caractere recu ; le lire remet RXR a zero. LECTURE SEULE (manuel CPU p12-14)
0BF000                   	txd:    equ 0FAH ; UART Transmit Buffer : le caractere a emettre ; peut etre ecrit pendant l'emission du precedent, TXR dit si le tampon est libre. ECRITURE SEULE (manuel CPU p14-15)
0BF000                   	imr:    equ 0FBH ; Interrupt Mask Register : bit 7 IRM masque general, bit 6 EXM interruption EXTERNE (pin IRQ ; sur PC-E500 ce pin est cable au controleur de batterie, d'ou 'batterie faible' cote machine), bit 5 RXRM reception SIO, bit 4 TXRM em ...
0BF000                   	ssr:    equ 0FFH ; System Status Register : bit 3 ONK touche ON enfoncee, bit 2 RSF (1 : on sort d'un HALT/OFF, 0 : le pin RESET a ete active), bit 1 CI entree cassette, bit 0 TEST entree de test. LECTURE SEULE (manuel CPU p20-21)
0BF000                   	s1_top:           equ 0BFC15H ; top of S1 (nom et libelle de REGISTER.ASM) ; lead address du slot 0 = lecteur S1:, 080000h sur PC-E500S (3 octets ; manuel technique, Parameter of memory block device)
0BF000                   	d_link:           equ 0BFCA2H ; device link pointer / IOCSH
0BF000                   	softint:          equ 0BFCBEH ; bit 7 = break, bit 6 = batterie faible
0BF000                   	intv_sio_rx:      equ 0BFCD5H ; vecteur interruption reception SIO, ISR/IMR bit 5 RXRM ; reception d'un octet SIO terminee (manuel technique, List of interrupt factor p91-92)
0BF000                   	s1_btm:           equ 0BFCDEH ; bottom of S1 (nom et libelle de REGISTER.ASM) ; le manuel dit "last address of slot 0 (S1:) + 1" et La Feuille du Sharp en fait le pointeur de la 1re zone de travail, la pile utilisateur U : trois lectures d'une me ...
0BF000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
0BF000                   	sio_baud:         equ 0BFD33H ; reglage de la liaison SIO : bits 6-4 = vitesse (001 300, 010 600, 011 1200, 100 2400, 101 4800, 110 9600 bauds ; 000 aucune), bits 3-2 = parite (00 paire, 01 impaire, 1x aucune), bit 1 = longueur (0 : 8 bits, 1 : 7 ...
0BF000                   	fcs_call:         equ 0FFFE4H ; FCS call entry
0BF000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
0BF000                   	fcs_write_block:          equ 04H   ; ecriture d'un bloc ((cl) = handle, X = source, Y = nombre d'octets ; retour X = adresse su
0BF000                   	fcs_write_byte:           equ 06H   ; ecriture d'un octet ((cl) = handle, a = donnee ; retour b = nombre d'octets ecrits)
0BF000                   	iocs_find_drive:          equ 00H   ; recherche du device et du lecteur d'apres le nom de lecteur (X = adresse du nom ; retour (
0BF000                   	iocs_header_addr:         equ 01H   ; adresse du header d'apres le numero de device ((cl) = device ; retour X = adresse du heade
0BF000                   	iocs_fmt_drive:           equ 04H   ; iocs_format_drive - formatage du device designe par le nom de lecteur (X = nom de lecteur suivi de la chaine d
0BF000                   	dev_key:          equ 1H    ; device 1 (STDI:/KYBD:)
0BF000                   	dev_memcard:      equ 6H    ; device 6 (S1:/S2:/S3:)
0BF000                   	d1_key_read:      equ 43H   ; key_key_read - lecture d'une touche, apres traitement des touches SHIFT et CTRL (a bit 7 = 0 ...
0BF000                   	d1_buffer_clear:  equ 45H   ; key_buffer_clear - vidage du tampon de balayage et du tampon clavier
0BF000                   	d6_search_phys:   equ 41H   ; memcard_search_phys - adresse physique d'un bloc d'apres son nom ((ch) = slot 0/1/2, X = nom du bloc ...
0BF000                   	d6_condense:      equ 47H   ; memcard_condense - compactage de l'espace libre des blocs memoire ((ch) = slot)
0BF000                   	
0BF000                   	sectsiz:	equ	128
0BF000                   	cache_sect:	equ	sectsiz+1
0BF000                   	cache_next:	equ	cache_sect+2
0BF000                   	cache_size:	equ	cache_next+3
0BF000                   	n_fcache:	equ	7		;	Nombre de secteurs dans le cache FAT
0BF000                   	n_dcache:	equ	1		;	Nombre de secteurs dans le cache de donnees
0BF000                   	dtop:		equ	44
0BF000                   	timeout:	equ	40000		; Delai d'attente (environ 1 seconde)
0BF000                   	
