0BE4FA 00                			db	0
0BE4FB 01                			db	1
0BE4FC 00 00             			dw	0
0BE4FE 08                			db	8
0BE4FF 80 00             			dw	128
0BE501 38 00             			dw	56			;Numero du secteur de depart de la zone de donnees
0BE503 C9 07             			dw	1992+1		;Nombre total de secteurs dans la zone de donnees + 1
0BE505 18                			db	24			;Nombre total de secteurs dans la zone FAT
