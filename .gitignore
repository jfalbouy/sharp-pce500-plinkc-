# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# The maintainer's local master copy of the untouched archives (already
# published, pristine, under original/) and everything kept off the public
# repo: the author's own PLINKC.asm source, its French translation, and
# _local/driver/ -- our 2026 derivatives (A62 build, native port, BF000
# variant, PLINK2 study). See _local/driver/README.md for why.
Sources originaux/
_local/

# Personal virtual-disk folders / RAMFILE backups created when running the
# server (own Sharp programs, not part of the project).
Disk*/

# Office lock & temp files
~$*
*.tmp

# C object files (committed binaries: the .exe and original PLINKC/PLINK
# installers are on purpose; only stray build objects are ignored)
*.o
